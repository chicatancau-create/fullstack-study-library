{
  "name": "g2-judge-pack",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "smoke": "node 自测脚本/smoke.mjs",
    "grade": "node 自测脚本/grade.mjs 参考答案/index.mjs",
    "grade:ts": "node 自测脚本/grade-ts.mjs 参考答案/ts/pool.ts",
    "grade:cli": "node 自测脚本/grade-cli.mjs",
    "typecheck": "tsc -p tsconfig.json",
